                    </div>

                    {/* Icon Circle */}
                    <div className="w-32 h-32 rounded-[2.5rem] bg-[#1A1A1A] border border-white/5 flex items-center justify-center group-hover:border-[#FF7A00]/50 group-hover:bg-[#FF7A00]/5 transition-all duration-500 rotate-12 group-hover:rotate-0">
                      <Icon className="w-12 h-12 text-[#FF7A00] -rotate-12 group-hover:rotate-0 transition-all duration-500" />
                    </div>
                  </div>

                  {/* Text */}
                  <div className="space-y-4">
                    <h3 className="font-bold text-2xl text-white group-hover:text-[#FF7A00] transition-colors">
                      {step.title}
                    </h3>
                    <p className="text-sm text-gray-400 max-w-[280px] mx-auto leading-relaxed font-medium">
                      {step.desc}
                    </p>
                  </div>
                </motion.div>
              );
            })}
          </div>
        </div>
      </section>

      {/* Section-8: Newsletter */}
      <section className="py-24 bg-[#0F0F0F]">
        <div className="max-w-7xl mx-auto px-4">
          <motion.div
            initial={{ opacity: 0, y: 30 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            className="relative bg-[#1A1A1A] border border-[#FF7A00]/20 rounded-[3rem] p-10 md:p-16 overflow-hidden shadow-2xl"
          >
            {/* Background Effects */}
            <div className="absolute top-0 right-0 w-[500px] h-[500px] bg-[#FF7A00]/10 rounded-full blur-[120px] -mr-64 -mt-64 pointer-events-none" />
            <div className="absolute bottom-0 left-0 w-[300px] h-[300px] bg-[#FF7A00]/5 rounded-full blur-[100px] -ml-32 -mb-32 pointer-events-none" />
            
            <div className="flex flex-col lg:flex-row items-center justify-between gap-16 relative z-10">
              <div className="flex flex-col md:flex-row items-center gap-10 flex-1">
                <motion.div 
                  animate={{ y: [0, -10, 0] }}
                  transition={{ duration: 4, repeat: Infinity, ease: "easeInOut" }}
                  className="w-32 h-32 bg-[#FF7A00]/10 rounded-[2.5rem] flex items-center justify-center shrink-0 border border-[#FF7A00]/20 p-4"
                >
                  <img
                    src={books}
                    alt="Books"
                    className="w-full h-full object-contain"
                  />
                </motion.div>
                
                <div className="text-center md:text-left space-y-4">
                  <h3 className="text-3xl md:text-5xl font-black text-white leading-tight">
                    Stay Updated with <br />
                    <span className="text-[#FF7A00]">New Courses!</span>
                  </h3>
                  <p className="text-gray-400 font-medium text-lg max-w-md">
                    Subscribe to our newsletter and never miss updates on new courses and exclusive offers.
                  </p>
                </div>
              </div>

              <div className="w-full lg:w-auto">
                <form 
                  onSubmit={(e) => e.preventDefault()}
                  className="bg-[#111111] border border-white/10 rounded-[2rem] p-2 flex flex-col sm:flex-row gap-2 w-full lg:min-w-[500px] shadow-inner"
                >
                  <input
                    type="email"
                    placeholder="Enter your email address"
                    className="bg-transparent px-6 py-4 text-white focus:outline-none w-full font-medium"
                  />
                  <button className="bg-[#FF7A00] hover:bg-[#FF8A1F] text-white px-10 py-4 rounded-[1.5rem] font-black text-sm whitespace-nowrap shadow-lg shadow-[#FF7A00]/20 transition-all active:scale-95">
                    Subscribe Now
                  </button>
                </form>
                <p className="text-[10px] text-gray-500 font-bold uppercase tracking-widest text-center mt-4">
                  No spam, we promise. Only high-quality learning content.
                </p>
              </div>
            </div>
          </motion.div>
        </div>
      </section>


    </div>
  );
};

export default Home;