                </div>

                {/* Main Content Grid */}
                <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    
                    {/* Featured Speakers Section */}
                    <div className="lg:col-span-6 bg-[#0D0D14] border border-white/5 rounded-[40px] p-8 relative overflow-hidden group">
