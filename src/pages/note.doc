                                <stat.icon size={24} />
                            </div>
                            <div>
                                <div className="text-3xl font-black text-white tracking-tight">{stat.value}</div>
                                <div className="text-[10px] font-bold text-gray-500 uppercase tracking-widest">{stat.label}</div>
                            </div>
                        </div>
