            <div className="max-w-7xl mx-auto space-y-8">
                
                {/* Top Stats Banner */}
                <div className="bg-gradient-to-r from-[#1A0B2E] via-[#0D0B1F] to-[#0B1A2E] border border-white/5 rounded-[40px] p-8 md:p-12 flex flex-wrap justify-between items-center gap-8 shadow-2xl relative overflow-hidden group">
