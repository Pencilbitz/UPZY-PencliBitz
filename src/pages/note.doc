                              <div className="w-12 h-12 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-500">
                                <Globe size={24} />
                              </div>
                              <div>
                                <h4 className="text-white text-xl font-black tracking-tight">International Workshop</h4>
                                <p className="text-[10px] text-gray-500 uppercase tracking-widest font-bold">Global Leaders</p>
